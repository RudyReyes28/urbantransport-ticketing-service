# Perfil y puerto (nginx hace proxy desde el 80 a este puerto)
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Base de datos (URL JDBC completa)
DB_URL=jdbc:postgresql://<host>:5432/ticketing_db
DB_USERNAME=
DB_PASSWORD=

# Kafka (IP privada de la EC2 de Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Identity (IP privada de su EC2, sin puerto porque pasa por nginx)
IDENTITY_JWKS_URI=http://<IP_PRIVADA_IDENTITY>/.well-known/jwks.json

# Customer (IP privada de su EC2, sin puerto)
CUSTOMER_URL=http://<IP_PRIVADA_CUSTOMER>